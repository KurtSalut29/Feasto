# Copy to .env (docker compose reads it automatically). Never commit .env.
# Secret used to sign login sessions. All API copies and the web app must share it.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=change-me
# The admin account created by the seed step
ADMIN_EMAIL=admin@feasto.com
ADMIN_PASSWORD=change-me

# Optional: a Mapbox token, so the delivery fee uses road distances (otherwise they are estimated)
MAPBOX_TOKEN=

# Optional: push notifications that reach phones while Feasto is closed. Make the pair with
#   cd server && npx web-push generate-vapid-keys
# Keep the private key secret. Changing the keys means everyone turns notifications on again.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@feasto.com

# Optional: requests one signed-in account may make per minute (default 1200; 0 turns it off,
# only for the raw stress test loadtest/browse.js)
# API_REQUESTS_PER_MINUTE=1200
