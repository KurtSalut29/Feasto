# Copy to .env for local development (npm run dev:api / dev:worker).
# These point at the containers started by docker compose.
DATABASE_URL="postgresql://feasto:feasto@localhost:5432/feasto"
REDIS_URL="redis://localhost:6379"
RABBITMQ_URL="amqp://feasto:feasto@localhost:5672"
PORT=4000
INSTANCE_ID=api-local
# Must match JWT_SECRET in ../.env and ../web/.env.local
JWT_SECRET=change-me
COOKIE_SECURE=false
ADMIN_EMAIL=admin@feasto.com
ADMIN_PASSWORD=change-me
