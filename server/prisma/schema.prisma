// Feasto database schema.
// After editing this file run `npm run db:migrate` to create a migration.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  RESIDENT
  RIDER
  VENDOR
  ADMIN
}

/// Review state of a vendor's store or a rider's account. Admins move it out of PENDING.
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

/// The kind of food business. Residents filter stores by it.
enum StoreType {
  RESTAURANT
  FAST_FOOD
  CARINDERIA
  CAFE
  BAKERY
  MILK_TEA_DRINKS
  SNACKS_STREET_FOOD
  DESSERTS
  HOME_KITCHEN
}

enum VehicleType {
  MOTORCYCLE
  BICYCLE
  E_BIKE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum OrderStatus {
  AWAITING_PAYMENT // online payment not confirmed yet; vendors don't see it
  PLACED
  ACCEPTED
  PREPARING
  READY
  PICKED_UP // delivery: the rider collected it
  DELIVERED // delivery: handed to the resident
  COMPLETED // pickup: the resident collected it
  REJECTED
  CANCELLED
}

enum Fulfillment {
  DELIVERY
  PICKUP
}

enum PaymentMethod {
  COD
  ONLINE
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  role         Role     @default(RESIDENT)
  createdAt    DateTime @default(now())

  vendor        Vendor? // set when role = VENDOR
  riderProfile  RiderProfile? // set when role = RIDER
  checkouts     Checkout[]
  deliveries    Order[]        @relation("RiderDeliveries")
  bookings      Booking[]
  addresses     Address[]
  notifications Notification[]
}

/// A resident's saved delivery address.
model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  label     String // "Home", "Office"
  details   String // street, barangay, city
  landmark  String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Vendor {
  id                  String         @id @default(cuid())
  ownerId             String         @unique
  owner               User           @relation(fields: [ownerId], references: [id])
  name                String
  storeType           StoreType
  /// Only stores with this on appear under "Book a table"
  acceptsReservations Boolean        @default(false)
  description         String?
  address             String
  imageUrl            String?
  status              ApprovalStatus @default(PENDING)
  reviewNote          String? // admin's reason when rejecting or suspending
  reviewedAt          DateTime?
  opensAt             String // "08:00"
  closesAt            String // "21:00"
  /// The vendor's manual "closed for now" switch, on top of the opening hours
  isTemporarilyClosed Boolean        @default(false)
  createdAt           DateTime       @default(now())

  menuItems MenuItem[]
  orders    Order[]
  tables    DiningTable[]
}

/// A rider's vehicle details. Riders can't go online or take jobs until an admin approves them.
model RiderProfile {
  id            String         @id @default(cuid())
  userId        String         @unique
  user          User           @relation(fields: [userId], references: [id])
  vehicleType   VehicleType
  plateNumber   String? // required for motorcycles
  licenseNumber String?        @unique // driver's license, required for motorcycles
  status        ApprovalStatus @default(PENDING)
  reviewNote    String?
  reviewedAt    DateTime?
  isOnline      Boolean        @default(false)
  createdAt     DateTime       @default(now())
}

model MenuItem {
  id          String    @id @default(cuid())
  vendorId    String
  vendor      Vendor    @relation(fields: [vendorId], references: [id])
  name        String
  category    String    @default("Others") // the vendor's own menu section, e.g. "Rice Meals"
  description String?
  price       Decimal   @db.Decimal(10, 2)
  imageUrl    String?
  stock       Int? // null = unlimited
  isAvailable Boolean   @default(true)
  /// Deleted dishes are hidden but kept, because past orders point to them
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())

  orderItems OrderItem[]

  @@index([vendorId])
}

/// One payment for a cart that may contain items from several vendors.
/// It is split into one Order per vendor, and those orders are processed in parallel.
model Checkout {
  id              String        @id @default(cuid())
  residentId      String
  resident        User          @relation(fields: [residentId], references: [id])
  fulfillment     Fulfillment
  paymentMethod   PaymentMethod
  total           Decimal       @db.Decimal(10, 2)
  paymentStatus   PaymentStatus @default(PENDING)
  /// Sent by the client; a retried or double-clicked checkout reuses the key and is not created twice.
  idempotencyKey  String        @unique
  deliveryAddress String? // empty for pickup
  notes           String?
  createdAt       DateTime      @default(now())

  orders Order[]
}

/// The part of a checkout that belongs to a single vendor.
model Order {
  id           String      @id @default(cuid())
  checkoutId   String
  checkout     Checkout    @relation(fields: [checkoutId], references: [id])
  vendorId     String
  vendor       Vendor      @relation(fields: [vendorId], references: [id])
  riderId      String?
  rider        User?       @relation("RiderDeliveries", fields: [riderId], references: [id])
  status       OrderStatus @default(PLACED)
  fulfillment  Fulfillment
  subtotal     Decimal     @db.Decimal(10, 2)
  deliveryFee  Decimal     @default(0) @db.Decimal(10, 2)
  rejectReason String?
  acceptedAt   DateTime?
  readyAt      DateTime?
  pickedUpAt   DateTime?
  finishedAt   DateTime? // delivered, collected, rejected or cancelled
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  items OrderItem[]

  @@index([vendorId, status])
  @@index([riderId])
  @@index([checkoutId])
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  name       String // copied at order time so later menu edits don't change past orders
  unitPrice  Decimal  @db.Decimal(10, 2)
  quantity   Int
}

model DiningTable {
  id       String  @id @default(cuid())
  vendorId String
  vendor   Vendor  @relation(fields: [vendorId], references: [id])
  label    String // "Table 4"
  seats    Int
  /// Removed tables are hidden but kept, because past bookings point to them
  isActive Boolean @default(true)

  bookings Booking[]

  @@index([vendorId])
}

/// Reservations use fixed one-hour slots, so two bookings conflict only when they share a start time.
model Booking {
  id            String        @id @default(cuid())
  tableId       String
  table         DiningTable   @relation(fields: [tableId], references: [id])
  residentId    String
  resident      User          @relation(fields: [residentId], references: [id])
  startsAt      DateTime
  partySize     Int
  notes         String?
  status        BookingStatus @default(CONFIRMED)
  /// "<tableId>|<startsAt ISO>" while the booking is active, null once cancelled.
  /// The unique index lets the database reject a double-booking even when
  /// hundreds of requests for the same slot arrive at the same moment.
  activeSlotKey String?       @unique
  createdAt     DateTime      @default(now())

  @@index([tableId, startsAt])
}

/// In-app notification. New ones are also pushed live to the user's open pages.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

/// Transactional outbox: events are saved in the same database transaction as the
/// change they describe, then relayed to RabbitMQ. If RabbitMQ or an API copy is down
/// at that moment, the worker's relay publishes them later, so no event is lost.
model OutboxEvent {
  id          String    @id @default(cuid())
  topic       String
  payload     Json
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([publishedAt, createdAt])
}
