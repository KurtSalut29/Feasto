// Feasto database schema.
// After editing this file run `npm run db:migrate` to create a migration.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  RESIDENT
  RIDER
  VENDOR
  ADMIN
}

/// Review state of a vendor's store or a rider's account. Admins move it out of PENDING.
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

/// The kind of food business. Residents filter stores by it.
enum StoreType {
  RESTAURANT
  FAST_FOOD
  CARINDERIA
  CAFE
  BAKERY
  MILK_TEA_DRINKS
  SNACKS_STREET_FOOD
  DESSERTS
  HOME_KITCHEN
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum OrderStatus {
  AWAITING_PAYMENT // online payment not confirmed yet; vendors don't see it
  SCHEDULED // ordered for later: the store sees it coming, and gets it to accept a while before the time
  PLACED
  ACCEPTED
  PREPARING
  READY
  PICKED_UP // delivery: the rider collected it
  DELIVERED // delivery: handed to the resident
  COMPLETED // pickup: the resident collected it
  REJECTED
  CANCELLED
}

/// How far a delivery job has spread among riders. Each step is explained in lib/dispatch.ts.
enum JobDispatch {
  NEW
  /// The resident chose a rider: only they see the job, for a short while
  PREFERRED
  STORE_RIDERS
  NEAREST
  WIDER
  EVERYONE
}

/// Where a store's or rider's replacement document is. DRAFT has the file but wasn't submitted yet.
enum RenewalStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

/// The filters on the admin's activity log.
enum ActivityCategory {
  APPROVALS
  DOCUMENTS
  ACCOUNTS
  ORDERS
  SETTINGS
  /// Money settled with stores and riders
  EARNINGS
}

/// How big the app's text is, for people who read better with larger letters
enum MapStyle {
  DEFAULT
  SATELLITE
  NIGHT
}

enum TextSize {
  NORMAL
  LARGE
  XLARGE
}

/// Where Feasto sends a store's or rider's money from online orders (through Xendit Payouts)
enum PayoutChannel {
  GCASH
  MAYA
  BDO
  BPI
  METROBANK
  LANDBANK
  UNIONBANK
  SECURITY_BANK
}

enum PayoutParty {
  STORE
  RIDER
}

enum PayoutStatus {
  /// Waiting for a worker to send it
  PENDING
  /// The store or rider hasn't said where to send money yet; sent once they do
  NEEDS_ACCOUNT
  /// Xendit accepted it and is sending it to the e-wallet or bank
  SENDING
  SENT
  /// Xendit couldn't send it (wrong account, low balance...); can be sent again
  FAILED
}

/// What the store does when an item ran out after the order was placed
enum IfUnavailable {
  REMOVE // take it off and refund it
  CALL // call the resident first
  CANCEL // cancel the whole order
}

enum Fulfillment {
  DELIVERY
  PICKUP
}

enum PaymentMethod {
  COD
  ONLINE
}

/// Which wallet or card an online payment uses. Payments are simulated; no money moves.
enum OnlinePayment {
  GCASH
  MAYA
  GRABPAY
  SHOPEEPAY
  COINS
  VISA
  MASTERCARD
  JCB
  AMEX
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String
  name              String
  phone             String?
  role              Role      @default(RESIDENT)
  /// Set by an admin to block the account; the user is logged out everywhere at once
  disabledAt        DateTime?
  /// Suspended by the admin after a report: can sign in, but can't order, take jobs or get orders until then.
  /// Feasto lifts it by itself when the time is up (an "until the admin lifts it" suspension is year 2999).
  suspendedUntil    DateTime?
  /// The name in parts, as on a valid ID; `name` is them joined, for display
  firstName         String?
  middleName        String?
  lastName          String?
  suffix            String?
  /// A resident's valid ID: what kind, the photo (private, in the documents folder) and the admin's check
  idType            String?
  idFile            String?
  idStatus          IdCheck?
  idReviewNote      String?
  idReviewedAt      DateTime?
  /// Sessions signed before this moment stop working, so a new password logs out other devices
  passwordChangedAt DateTime?
  /// Orders the rider couldn't hand over because nobody came to the door
  noShows           Int       @default(0)
  /// Two-step login: the authenticator app's secret (encrypted, lib/totp.ts), when it was turned on,
  /// and the hashes of the unused backup codes
  totpSecret        String?
  totpEnabledAt     DateTime?
  backupCodes       String[]  @default([])
  /// Display & accessibility, chosen by the person and applied on every device they log in on
  textSize          TextSize  @default(NORMAL)
  highContrast      Boolean   @default(false)
  reduceMotion      Boolean   @default(false)
  largeTargets      Boolean   @default(false)
  /// How maps look: the usual map, satellite photos, or dark for night rides
  mapStyle          MapStyle  @default(DEFAULT)
  /// When the person agreed to Feasto's Terms of Service and Privacy Policy, and which version
  termsAcceptedAt   DateTime?
  termsVersion      String?
  createdAt         DateTime  @default(now())

  vendor        Vendor? // set when role = VENDOR
  riderProfile  RiderProfile? // set when role = RIDER
  checkouts     Checkout[]
  deliveries    Order[]        @relation("RiderDeliveries")
  /// Deliveries where the resident asked for this rider first
  preferredFor  Order[]        @relation("PreferredRider")
  /// Pabili: errands a resident asked for, ones a rider runs, and ones a resident asked this rider for
  errands       Errand[]       @relation("ResidentErrands")
  /// As on their ID (residents): alcohol and cigarettes are for 18 and older
  birthDate     DateTime?      @db.Date
  shopSuggestions PabiliShopSuggestion[]
  errandRuns    Errand[]       @relation("RiderErrands")
  errandAsks    Errand[]       @relation("PreferredErrandRider")
  /// Reports this person sent, and reports about them
  reportsMade    Report[]           @relation("ReportsMade")
  reportsAgainst Report[]           @relation("ReportsAgainst")
  settlements   Settlement[]   @relation("RiderSettlements")
  feastoPayments FeastoPayment[] @relation("RiderFeastoPayments")
  payouts       Payout[]       @relation("RiderPayouts")
  jobOffers     JobOffer[]
  bookings      Booking[]
  addresses     Address[]
  notifications Notification[]
  payMethods    SavedPayMethod[]
  reviews       Review[]
  favorites     Favorite[]
  orderMessages OrderMessage[]  @relation("OrderMessages")
  chatReads     OrderChatRead[]
  pushDevices   PushSubscription[]
  riderRatings  RiderRating[]  @relation("RatingsReceived")
  ratingsGiven  RiderRating[]  @relation("RatingsGiven")

  @@index([role, idStatus])
  knownDevices      KnownDevice[]
}

/// A resident's saved delivery address.
model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  label     String // "Home", "Office"
  details   String // street, barangay, city
  landmark  String?
  /// Pin on the map, set by the resident (GPS or dragging the pin)
  latitude  Float?
  longitude Float?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Vendor {
  id                  String         @id @default(cuid())
  ownerId             String         @unique
  owner               User           @relation(fields: [ownerId], references: [id])
  name                String
  storeType           StoreType
  /// Only stores with this on appear under "Book a table"
  acceptsReservations Boolean        @default(false)
  description         String?
  address             String
  /// Pin on the map, set by the vendor in Store settings
  latitude            Float?
  longitude           Float?
  imageUrl            String?
  /// The registered business, which can differ from the name residents see
  businessName        String?
  businessPhone       String?
  permitNumber        String?
  permitExpiresAt     DateTime?      @db.Date
  /// Set by Feasto when the permit has been expired longer than the grace period: the store takes no
  /// orders or bookings until a renewed permit is approved (cleared then)
  permitPausedAt      DateTime?
  /// File name of the business permit in the private documents folder, never a public URL
  permitFile          String?
  /// Riders enter this when they sign up to join this store
  riderCode           String         @unique
  status              ApprovalStatus @default(PENDING)
  reviewNote          String? // admin's reason when rejecting or suspending
  reviewedAt          DateTime?
  opensAt             String // "08:00"
  closesAt            String // "21:00"
  /// The vendor's manual "closed for now" switch, on top of the opening hours
  isTemporarilyClosed Boolean        @default(false)
  /// Ways to pay this store takes. A cart's choices are the ones every store in it takes.
  acceptsCash         Boolean        @default(true)
  onlinePayments      OnlinePayment[] @default([GCASH, MAYA, GRABPAY, SHOPEEPAY, COINS, VISA, MASTERCARD, JCB, AMEX])
  /// Running totals of all ratings, updated in the same transaction as each new review,
  /// so store lists can show the average without adding up every review
  ratingSum           Int            @default(0)
  ratingCount         Int            @default(0)
  /// A new store's first month is free: orders before this pay Feasto no commission.
  /// Set once, when the admin first approves the store.
  commissionFreeUntil DateTime?
  /// The commission agreed with this store, in percent; empty uses the default in Settings
  commissionPercent       Decimal?  @db.Decimal(4, 1)
  pickupCommissionPercent Decimal?  @db.Decimal(4, 1)
  /// The admin's note about the agreement, e.g. "Signed Nov 25"
  commissionNote          String?
  commissionSetAt         DateTime?
  /// How long the kitchen usually takes, and how much more for every 5 items after the first 5
  prepMinutes             Int       @default(15)
  prepPer5Items           Int       @default(5)
  /// Busy kitchen: minutes added to every new order until busyUntil
  busyExtraMinutes        Int       @default(0)
  busyUntil               DateTime?
  /// The farthest it delivers, by road
  deliveryRadiusKm        Decimal   @default(7) @db.Decimal(4, 1)
  /// How far ahead a big order must be placed (0 = it can be ordered now)
  largeOrderNoticeMinutes Int       @default(0)
  /// Where Feasto sends the store's money from online orders: an e-wallet or bank account
  payoutChannel       PayoutChannel?
  payoutName          String?
  payoutNumber        String?
  createdAt           DateTime       @default(now())

  menuItems   MenuItem[]
  settlements Settlement[]
  feastoPayments FeastoPayment[]
  payouts     Payout[]
  orders    Order[]
  tables    DiningTable[]
  reviews   Review[]
  favoredBy Favorite[]
  riders    RiderProfile[]
  renewals  DocumentRenewal[]
  pabiliShops PabiliShop[]
}

/// A motorcycle rider's details. Riders can't go online or take jobs until they're approved:
/// by their store if they joined one with its code, otherwise by the admin.
model RiderProfile {
  id               String         @id @default(cuid())
  userId           String         @unique
  user             User           @relation(fields: [userId], references: [id])
  /// The store this rider works for; null for a free rider
  vendorId         String?
  vendor           Vendor?        @relation(fields: [vendorId], references: [id])
  /// Motorcycle make and model, e.g. Honda Click 125
  vehicleModel     String?
  plateNumber      String?
  licenseNumber    String?        @unique
  licenseExpiresAt DateTime?      @db.Date
  /// File name of the license photo in the private documents folder, never a public URL
  licenseFile      String?
  birthDate        DateTime?      @db.Date
  address          String?
  emergencyName    String?
  emergencyPhone   String?
  status           ApprovalStatus @default(PENDING)
  reviewNote       String?
  reviewedAt       DateTime?
  /// Only the admin can lift a suspension the admin made, not the rider's store
  suspendedByAdmin Boolean        @default(false)
  isOnline         Boolean        @default(false)
  /// Running totals of residents' ratings of this rider, updated with each new rating
  ratingSum        Int            @default(0)
  ratingCount      Int            @default(0)
  /// Where Feasto sends the rider's money from online orders: an e-wallet or bank account
  payoutChannel    PayoutChannel?
  payoutName       String?
  payoutNumber     String?
  createdAt        DateTime       @default(now())

  renewals DocumentRenewal[]

  @@index([vendorId, status])
}

/// A replacement for an approved store's permit or rider's license. It stays separate until the
/// reviewer approves it, so the document on file is always one that somebody checked.
/// The migration adds partial unique indexes: at most one DRAFT or PENDING per store or rider.
model DocumentRenewal {
  id          String        @id @default(cuid())
  vendorId    String?
  vendor      Vendor?       @relation(fields: [vendorId], references: [id])
  riderId     String?
  rider       RiderProfile? @relation(fields: [riderId], references: [id])
  number      String?
  expiresAt   DateTime?     @db.Date
  /// File name in the private documents folder, until it's approved or rejected
  file        String?
  status      RenewalStatus @default(DRAFT)
  note        String? // the reason when rejected
  submittedAt DateTime?
  reviewedAt  DateTime?
  createdAt   DateTime      @default(now())

  @@index([status, submittedAt])
  @@index([vendorId])
  @@index([riderId])
}

/// What was done on Feasto, by whom, and why. The API only ever adds lines.
/// Names are copied so an old line stays true after someone changes their name.
model ActivityLog {
  id        String           @id @default(cuid())
  /// Null when Feasto did it automatically
  actorId   String?
  actorName String
  category  ActivityCategory
  action    String
  target    String
  detail    String?
  createdAt DateTime         @default(now())

  @@index([createdAt])
  @@index([category, createdAt])
}

/// What the admin can change without a new release. There's only ever one row, with id 1.
model PlatformSettings {
  id                Int      @id @default(1)
  /// Base delivery fee per store, covering the first `deliveryBaseKm` km. Orders keep the fee they were placed with.
  deliveryFee       Decimal  @default(49) @db.Decimal(10, 2)
  /// How many kilometres (by road) the base fee covers
  deliveryBaseKm    Decimal  @default(2) @db.Decimal(4, 1)
  /// Added for every kilometre (or part of one) after that
  deliveryPerKm     Decimal  @default(8) @db.Decimal(10, 2)
  /// Added to the delivery fee when more orders are waiting than there are free riders (0 = off). All of it goes to the rider.
  busyFeeMax        Decimal  @default(20) @db.Decimal(10, 2)
  /// Added while it rains (the admin's switch, or two riders reporting rain). All of it goes to the rider.
  rainFee           Decimal  @default(10) @db.Decimal(10, 2)
  /// How long a store's own riders have a job to themselves
  storeRiderSeconds Int      @default(60)
  /// The wait between waves of free riders
  riderWaveSeconds  Int      @default(30)
  /// How long an order waits for a store or rider before the admin is told
  stuckMinutes      Int      @default(15)
  /// An order the store didn't accept, or no rider took, in this many minutes is cancelled by itself (0 = never)
  autoCancelMinutes Int      @default(10)
  /// Accounts one network (one internet address) may create in 10 minutes. Only applies where
  /// Feasto can see addresses: through the tunnel and on a cloud server, not on the classroom laptop
  signupsPerNetwork Int      @default(20)
  /// Feasto's commission on the food of a delivery order, in percent. Orders keep the rate they were placed with.
  commissionPercent       Decimal @default(10) @db.Decimal(4, 1)
  /// The same for pickup orders: lower, because no rider is needed
  pickupCommissionPercent Decimal @default(5) @db.Decimal(4, 1)
  /// Feasto's share of a Pabili fee, in percent. Food deliveries have none: the rider keeps the whole fee.
  pabiliFeePercent        Decimal @default(10) @db.Decimal(4, 1)
  /// How many days a newly approved store pays no commission
  freeTrialDays           Int     @default(30)
  /// The most a rider may spend on one Pabili. They pay with their own money and are paid back in cash.
  pabiliBudgetMax         Int     @default(1000)
  /// An order to one store is big from this many items, or this many pesos
  largeOrderItems         Int     @default(20)
  largeOrderAmount        Int     @default(3000)
  /// Cash on delivery is for checkouts up to this; bigger ones are paid online
  codMaxAmount            Int     @default(3000)
  /// After this many orders not received at the door, the resident can only pay online
  noShowStrikes           Int     @default(2)
  /// How long the rider waits at the door before they may mark it not received
  doorWaitMinutes         Int     @default(10)
  /// Admins and store owners must use an authenticator app to log in
  require2fa              Boolean @default(true)
  /// A liquor ban is on: no alcohol through Pabili
  liquorBan               Boolean @default(false)
  updatedAt         DateTime @updatedAt
}

model MenuItem {
  id          String    @id @default(cuid())
  vendorId    String
  vendor      Vendor    @relation(fields: [vendorId], references: [id])
  name        String
  category    String    @default("Others") // the vendor's own menu section, e.g. "Rice Meals"
  description String?
  price       Decimal   @db.Decimal(10, 2)
  imageUrl    String?
  stock       Int? // null = unlimited
  isAvailable Boolean   @default(true)
  /// Deleted dishes are hidden but kept, because past orders point to them
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())

  orderItems OrderItem[]

  @@index([vendorId])
}

/// One payment for a cart that may contain items from several vendors.
/// It is split into one Order per vendor, and those orders are processed in parallel.
model Checkout {
  id              String        @id @default(cuid())
  residentId      String
  resident        User          @relation(fields: [residentId], references: [id])
  fulfillment     Fulfillment
  paymentMethod   PaymentMethod
  /// Set for online payments; empty for cash and for orders from before wallets were offered
  onlineMethod    OnlinePayment?
  total           Decimal       @db.Decimal(10, 2)
  paymentStatus   PaymentStatus @default(PENDING)
  /// Online payments through Xendit: the invoice's id, and its payment page the resident is sent to
  paymentRef      String?       @unique
  paymentUrl      String?
  /// What the resident actually paid with on that page, e.g. GCASH or CREDIT_CARD
  paidChannel     String?
  /// Sent by the client; a retried or double-clicked checkout reuses the key and is not created twice.
  idempotencyKey  String        @unique
  /// What the store does when an item ran out after the order was placed
  ifUnavailable   IfUnavailable @default(REMOVE)
  deliveryAddress String? // empty for pickup
  /// The address pin, copied at order time like the address text
  deliveryLat     Float?
  deliveryLng     Float?
  notes           String?
  createdAt       DateTime      @default(now())
  /// Paid by sending money to one of Feasto's own accounts (set by the admin) instead of on Xendit's
  /// page. The admin checks it against the account's history before the orders go to the stores.
  transferAccountId String?
  transferAccount   ReceivingAccount? @relation(fields: [transferAccountId], references: [id], onDelete: Restrict)
  /// Copied at checkout ("GCash 0917 123 4567, Feasto Naval"), so the line stays true if the account changes
  transferTo        String?
  /// The reference number on the resident's receipt; the same one can't pay two orders
  transferRef       String?       @unique
  /// The resident's screenshot of the receipt, a private file like the documents
  transferProof     String?
  /// The resident's account it came from, e.g. "GCash 0918 765 4321, Juan Dela Cruz"
  transferFrom      String?
  transferSentAt    DateTime?
  transferCheckedAt DateTime?
  /// Why the admin couldn't confirm it
  transferNote      String?

  orders Order[]

  @@index([transferSentAt])
}

/// Where residents can send a bank or e-wallet transfer for an online order. The admin sets these.
enum ReceiveChannel {
  GCASH
  MAYA
  BANK
}

model ReceivingAccount {
  id            String         @id @default(cuid())
  channel       ReceiveChannel
  /// BANK only: which bank, e.g. BDO
  bankName      String?
  accountName   String
  accountNumber String
  /// The account's QR code (GCash or Maya "Receive money"), a photo served from /uploads
  qrUrl         String?
  enabled       Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  checkouts     Checkout[]
}

/// A resident's own way to pay, shown on the checkout's payment card. A card keeps only what's
/// safe to keep: the brand, the last 4 digits, the expiry and the name. Never the full number or the CVV.
enum PayMethodKind {
  GCASH
  MAYA
  CARD
}

model SavedPayMethod {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       PayMethodKind
  holderName String
  /// E-wallets: the 11-digit mobile number
  number     String?
  /// Cards: VISA, MASTERCARD, JCB or AMEX, and the last 4 digits
  brand      OnlinePayment?
  last4      String?
  expMonth   Int?
  expYear    Int?
  createdAt  DateTime       @default(now())

  @@index([userId])
}

/// The part of a checkout that belongs to a single vendor.
model Order {
  id               String      @id @default(cuid())
  checkoutId       String
  checkout         Checkout    @relation(fields: [checkoutId], references: [id])
  vendorId         String
  vendor           Vendor      @relation(fields: [vendorId], references: [id])
  riderId          String?
  rider            User?       @relation("RiderDeliveries", fields: [riderId], references: [id])
  /// The rider the resident chose at checkout; the job is theirs alone for a short while, then goes to everyone
  preferredRiderId String?
  preferredRider   User?       @relation("PreferredRider", fields: [preferredRiderId], references: [id])
  status           OrderStatus @default(PLACED)
  fulfillment      Fulfillment
  subtotal         Decimal     @db.Decimal(10, 2)
  deliveryFee      Decimal     @default(0) @db.Decimal(10, 2)
  /// Road distance from the store to the resident when it was ordered, which set the fee
  deliveryKm       Decimal?    @db.Decimal(5, 1)
  rejectReason     String?
  /// Photo the rider took at the door, under /uploads/
  deliveryPhotoUrl String?
  /// What the resident gave the rider on top of the delivery fee, after it arrived. All of it goes to the rider.
  tip              Decimal     @default(0) @db.Decimal(10, 2)
  /// The e-wallet or card the tip was paid with
  tipMethod        OnlinePayment?
  /// When this order's part of an online payment was given back, because it was cancelled or
  /// declined after the resident paid. Once set, it's never refunded again.
  refundedAt       DateTime?
  /// The payment provider's refund id, or why it couldn't refund it
  refundNote       String?
  /// Feasto's commission, copied at checkout like the delivery fee: the percent and what it comes to.
  /// Feasto earns it only once the order is delivered or collected; cancelled and declined orders pay nothing.
  commissionRate   Decimal     @default(0) @db.Decimal(4, 1)
  commission       Decimal     @default(0) @db.Decimal(10, 2)
  /// Feasto's share of the delivery fee, the same way. The rider keeps the rest, and every tip.
  riderCutRate     Decimal     @default(0) @db.Decimal(4, 1)
  riderCut         Decimal     @default(0) @db.Decimal(10, 2)
  /// The part of the delivery fee added because riders were busy or it rained, and why. Already in deliveryFee; all of it is the rider's.
  extraFee         Decimal     @default(0) @db.Decimal(10, 2)
  extraFeeNote     String?
  /// Ordered for later: when the resident wants it delivered (or ready for pickup). Null means as soon as possible.
  scheduledFor     DateTime?
  /// When the store said it would be ready, set when it accepts and moved when it runs late
  readyBy          DateTime?
  /// How many times the store said it needs more time, and its last reason
  delays           Int         @default(0)
  delayNote        String?
  /// The rider said they're at the door
  arrivedAt        DateTime?
  /// Cancelled because nobody came to the door: counts against the resident
  noShow           Boolean     @default(false)
  /// When it reached the store to accept: at checkout, after the online payment, or when a scheduled order was sent.
  /// The store's time to accept (and the auto-cancel) counts from here, not from when it was ordered.
  placedAt         DateTime    @default(now())
  dispatch         JobDispatch @default(NEW)
  /// When the job should reach more riders; null when there's nothing left to do
  nextDispatchAt   DateTime?
  acceptedAt       DateTime?
  readyAt          DateTime?
  pickedUpAt       DateTime?
  finishedAt       DateTime? // delivered, collected, rejected or cancelled
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  items     OrderItem[]
  review    Review?
  riderRating RiderRating?
  offers    JobOffer[]
  messages  OrderMessage[]
  payouts   Payout[]
  chatReads OrderChatRead[]

  reports Report[]

  @@index([vendorId, status])
  @@index([riderId])
  @@index([checkoutId])
  @@index([nextDispatchAt])
  @@index([status, scheduledFor])
}

/// Feasto's share of cash orders, collected from a store or a rider by the admin.
/// Online payments need no settling: Feasto holds them until the order is delivered or collected,
/// then sends the store and the rider their part right away. Cash goes straight to the store and
/// the rider, so they owe Feasto its share; what's still owed is everything earned minus everything settled.
model Settlement {
  id            String   @id @default(cuid())
  /// Exactly one of these: the store, or the rider (their user id)
  vendorId      String?
  vendor        Vendor?  @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  riderId       String?
  rider         User?    @relation("RiderSettlements", fields: [riderId], references: [id], onDelete: Restrict)
  /// What they paid Feasto: its share of their cash orders
  amount        Decimal  @db.Decimal(12, 2)
  /// Finished cash orders this settlement covered
  orders        Int
  /// How they paid: the e-wallet or card when the store or rider paid in the app;
  /// empty when they handed the money to the admin, who marked it received
  method        OnlinePayment?
  settledById   String?
  /// Copied, so the line stays true after a rename
  settledByName String
  note          String?
  createdAt     DateTime @default(now())
  /// The Xendit payment it came from, when they paid in the app
  payment       FeastoPayment?

  @@index([vendorId, createdAt])
  @@index([riderId, createdAt])
}

/// A store or rider paying Feasto its share of their cash orders in the app, on Xendit's payment
/// page. The money can only go to Feasto's own Xendit account: nobody types where it goes. It
/// becomes a Settlement only once Xendit confirms it was paid, never because a button was pressed.
model FeastoPayment {
  id           String        @id @default(cuid())
  /// Exactly one of these: the store, or the rider (their user id)
  vendorId     String?
  vendor       Vendor?       @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  riderId      String?
  rider        User?         @relation("RiderFeastoPayments", fields: [riderId], references: [id], onDelete: Restrict)
  /// What they owed when they started, and the cash orders it covers
  amount       Decimal       @db.Decimal(12, 2)
  orders       Int
  /// The way they chose in Feasto; once paid, what they really paid with on Xendit's page
  method       OnlinePayment
  status       PaymentStatus @default(PENDING)
  /// Xendit's invoice (its payment page)
  invoiceId    String?       @unique
  invoiceUrl   String?
  paidChannel  String?
  /// Why it didn't go through, in plain words
  failure      String?
  settlementId String?       @unique
  settlement   Settlement?   @relation(fields: [settlementId], references: [id], onDelete: SetNull)
  paidById     String
  /// Copied, so the line stays true after a rename
  paidByName   String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([vendorId, status])
  @@index([riderId, status])
  @@index([status, createdAt])
}

/// Money Feasto sends out after an online order is delivered or collected: the store's food
/// minus the commission, and the rider's fee minus Feasto's share. One per order and party.
/// Sent through Xendit Payouts (test mode) to the e-wallet or bank they chose.
model Payout {
  id            String        @id @default(cuid())
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  party         PayoutParty
  /// Exactly one of these, matching the party
  vendorId      String?
  vendor        Vendor?       @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  riderId       String?
  rider         User?         @relation("RiderPayouts", fields: [riderId], references: [id], onDelete: Restrict)
  amount        Decimal       @db.Decimal(12, 2)
  status        PayoutStatus  @default(PENDING)
  /// Copied when it's sent, so the line stays true after they change their account
  channel       PayoutChannel?
  accountName   String?
  accountNumber String?
  /// Xendit's id for this payout; empty while simulated or not sent yet
  xenditId      String?       @unique
  /// Each try uses a new idempotency key, so a retry after a failure is a new payout at Xendit
  attempts      Int           @default(0)
  /// Why it failed, in plain words
  failure       String?
  sentAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([orderId, party])
  @@index([vendorId, createdAt])
  @@index([riderId, createdAt])
  @@index([status])
}

/// A free rider this job has reached so far. Only they can see and accept it until it opens to everyone.
model JobOffer {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  riderId   String
  rider     User     @relation(fields: [riderId], references: [id])
  createdAt DateTime @default(now())

  @@unique([orderId, riderId])
  @@index([riderId])
}

/// A browser or phone that gets this person's notifications while Feasto is closed (Web Push).
/// The push service gives each browser its own endpoint; a dead one is deleted the first time a
/// push to it fails.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

/// The order's chat: the resident, the store and (once there is one) the rider, in one thread.
/// Deleting the order or the account deletes its messages.
model OrderMessage {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User     @relation("OrderMessages", fields: [senderId], references: [id], onDelete: Cascade)
  /// The sender's part in the order: RESIDENT, VENDOR (the store) or RIDER
  senderRole Role
  body       String
  createdAt  DateTime @default(now())

  @@index([orderId, createdAt])
}

/// When each person last read an order's chat, for the unread count on its Chat button.
model OrderChatRead {
  orderId String
  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt  DateTime @default(now())

  @@id([orderId, userId])
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  name       String // copied at order time so later menu edits don't change past orders
  unitPrice  Decimal  @db.Decimal(10, 2)
  quantity   Int
  /// The resident's note for this dish only, e.g. "No onions"
  note       String?
  /// The store ran out after the order was placed: taken off the order and not charged
  removedAt  DateTime?
}

model DiningTable {
  id       String  @id @default(cuid())
  vendorId String
  vendor   Vendor  @relation(fields: [vendorId], references: [id])
  label    String // "Table 4"
  seats    Int
  /// Removed tables are hidden but kept, because past bookings point to them
  isActive Boolean @default(true)

  bookings Booking[]

  @@index([vendorId])
}

/// Reservations use fixed one-hour slots, so two bookings conflict only when they share a start time.
model Booking {
  id            String        @id @default(cuid())
  tableId       String
  table         DiningTable   @relation(fields: [tableId], references: [id])
  residentId    String
  resident      User          @relation(fields: [residentId], references: [id])
  startsAt      DateTime
  partySize     Int
  notes         String?
  status        BookingStatus @default(CONFIRMED)
  /// "<tableId>|<startsAt ISO>" while the booking is active, null once cancelled.
  /// The unique index lets the database reject a double-booking even when
  /// hundreds of requests for the same slot arrive at the same moment.
  activeSlotKey String?       @unique
  createdAt     DateTime      @default(now())

  reports Report[]

  @@index([tableId, startsAt])
}

/// A resident's rating of a finished order. One per order.
model Review {
  id         String   @id @default(cuid())
  orderId    String   @unique
  order      Order    @relation(fields: [orderId], references: [id])
  vendorId   String
  vendor     Vendor   @relation(fields: [vendorId], references: [id])
  residentId String
  resident   User     @relation(fields: [residentId], references: [id])
  rating     Int // 1 to 5 stars
  comment    String?
  createdAt  DateTime @default(now())

  @@index([vendorId, createdAt])
}

/// A resident's rating of the rider who delivered their order. One per order, separate from the store's.
model RiderRating {
  id          String   @id @default(cuid())
  orderId     String   @unique
  order       Order    @relation(fields: [orderId], references: [id])
  riderId     String
  rider       User     @relation("RatingsReceived", fields: [riderId], references: [id])
  residentId  String
  resident    User     @relation("RatingsGiven", fields: [residentId], references: [id])
  rating      Int // 1 to 5 stars
  /// Quick picks: what went well ("On time") or, for 1 to 3 stars, what didn't ("Late")
  tags        String[] @default([])
  comment     String?
  createdAt   DateTime @default(now())

  @@index([riderId, createdAt])
}

/// A store a resident saved to find again quickly.
model Favorite {
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id])
  createdAt DateTime @default(now())

  @@id([userId, vendorId])
  @@index([vendorId])
}

/// In-app notification. New ones are also pushed live to the user's open pages.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

/// Transactional outbox: events are saved in the same database transaction as the
/// change they describe, then relayed to RabbitMQ. If RabbitMQ or an API copy is down
/// at that moment, the worker's relay publishes them later, so no event is lost.
model OutboxEvent {
  id          String    @id @default(cuid())
  topic       String
  payload     Json
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([publishedAt, createdAt])
}

/// Pabili: a resident asks a rider to buy things at a shop that isn't on Feasto and bring them.
enum ErrandStatus {
  /// Waiting for a rider (the chosen one first, then any free rider nearby)
  REQUESTED
  /// A rider took it and is on the way to the shop
  ACCEPTED
  /// Bought: the receipt is in, the rider is on the way to the resident
  BOUGHT
  DELIVERED
  CANCELLED
}

model Errand {
  id               String       @id @default(cuid())
  residentId       String
  resident         User         @relation("ResidentErrands", fields: [residentId], references: [id])
  riderId          String?
  rider            User?        @relation("RiderErrands", fields: [riderId], references: [id])
  /// The rider the resident asked for; they have it to themselves until exclusiveUntil
  preferredRiderId String?
  preferredRider   User?        @relation("PreferredErrandRider", fields: [preferredRiderId], references: [id])
  exclusiveUntil   DateTime?
  shopName         String
  shopAddress      String
  /// Where the shop is: unknown until the rider buys there, then the spot their phone shared
  shopLat          Float?
  shopLng          Float?
  /// What to buy: [{ name, quantity, note }]
  items            Json
  notes            String?
  /// The most the rider may spend on the items; paid back in cash on delivery with the fee
  budget           Decimal      @db.Decimal(10, 2)
  deliveryAddress  String
  deliveryLat      Float?
  deliveryLng      Float?
  /// The lowest fee until the rider buys; then the fee from where they bought, never above feeMax
  deliveryFee      Decimal      @db.Decimal(10, 2)
  /// The most the fee can be (a shop within PABILI_MAX_KM), set when it's sent
  feeMax           Decimal?     @db.Decimal(10, 2)
  /// Added because riders were busy or it rained when it was sent (in deliveryFee and feeMax); all of it is the rider's
  extraFee         Decimal      @default(0) @db.Decimal(10, 2)
  extraFeeNote     String?
  /// Feasto's share of the fee, without the extra: the percent, copied when it's sent, and what it came to
  feastoCutRate    Decimal      @default(0) @db.Decimal(4, 1)
  feastoCut        Decimal      @default(0) @db.Decimal(10, 2)
  /// What the shop's receipt says, and its photo; the resident pays this plus the fee
  receiptTotal     Decimal?     @db.Decimal(10, 2)
  receiptPhotoUrl  String?
  deliveryPhotoUrl String?
  status           ErrandStatus @default(REQUESTED)
  cancelReason     String?
  createdAt        DateTime     @default(now())
  acceptedAt       DateTime?
  boughtAt         DateTime?
  finishedAt       DateTime?

  /// The listed shop it was bought at, and its kind (also for a shop typed in)
  shopId           String?
  shop             PabiliShop?   @relation(fields: [shopId], references: [id])
  shopCategory     ShopCategory?
  /// The prescription's photo, in the private documents folder, for medicine that needs one
  prescriptionFile String?
  /// Alcohol or cigarettes on the list: the rider checks the ID at the door
  adultCheck       Boolean      @default(false)
  /// What the rider should know: "CHEMICAL", "LPG", "BULKY"
  handling         String[]     @default([])
  /// The resident's estimates added up
  estimateTotal    Decimal?     @db.Decimal(10, 2)
  /// A photo of what was bought, at the shop
  itemsPhotoUrl    String?
  /// Why the receipt looks high next to the estimates
  priceFlag        String?
  /// When the rider confirmed the ID at the door (alcohol, cigarettes)
  idCheckedAt      DateTime?
  /// When the resident confirmed they got everything
  confirmedAt      DateTime?

  reports Report[]

  @@index([status, createdAt])
  @@index([riderId, status])
  @@index([residentId, createdAt])
}

/// Why someone reported a person they dealt with on an order, a Pabili or a booking
enum ReportReason {
  PRANK_ORDER
  NO_SHOW
  RUDE
  UNSAFE_DRIVING
  WRONG_ITEMS
  OFF_APP_PAYMENT
  OTHER
}

/// Where a report is: waiting for the admin, or what the admin did
enum ReportStatus {
  OPEN
  DISMISSED
  WARNED
  SUSPENDED
}

/// A report about someone, always from an order, Pabili or booking both of them were part of
model Report {
  id             String       @id @default(cuid())
  reporterId     String
  reporter       User         @relation("ReportsMade", fields: [reporterId], references: [id])
  reporterRole   Role
  reportedId     String
  reported       User         @relation("ReportsAgainst", fields: [reportedId], references: [id])
  /// What the reported person was in it: the store (VENDOR), the rider, or the customer
  reportedRole   Role
  orderId        String?
  order          Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  errandId       String?
  errand         Errand?      @relation(fields: [errandId], references: [id], onDelete: SetNull)
  bookingId      String?
  booking        Booking?     @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  reason         ReportReason
  details        String
  photoUrl       String?
  status         ReportStatus @default(OPEN)
  /// The admin's words: the warning the reported person reads, or why it was dismissed
  adminNote      String?
  /// For a suspension: until when
  suspendedUntil DateTime?
  resolvedAt     DateTime?
  resolvedByName String?
  /// When the reported person read the warning (it shows once, after they sign in)
  warningSeenAt  DateTime?
  createdAt      DateTime     @default(now())

  /// One report per person, per person reported, per order / Pabili / booking
  @@unique([reporterId, reportedId, orderId])
  @@unique([reporterId, reportedId, errandId])
  @@unique([reporterId, reportedId, bookingId])
  @@index([status, createdAt])
  @@index([reportedId, createdAt])
}

/// Where the admin's check of a resident's valid ID is
enum IdCheck {
  PENDING
  VERIFIED
  REJECTED
}

/// A browser or phone an account has logged in from (a random id in a long-lived cookie, kept as a
/// hash). A new one sends a "new sign-in" alert; with two-step login, "remember this device" skips
/// the code on it until trustedUntil.
model KnownDevice {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceHash   String
  /// e.g. "Chrome on Android"
  label        String
  trustedUntil DateTime?
  lastSeenAt   DateTime  @default(now())
  createdAt    DateTime  @default(now())

  @@unique([userId, deviceHash])
}

enum DocVerdict {
  LOOKS_REAL
  REVIEW
  NOT_A_DOCUMENT
  /// The automatic check isn't set up, or couldn't run: the admin checks it by hand
  NOT_CHECKED
}

/// What the automatic check found in an uploaded ID, license or permit (lib/documentCheck.ts). The
/// admin still decides; this only says which ones need a closer look. The ID number itself is never
/// kept: only a keyed hash, to spot the same ID on two accounts (and none for a PhilSys ID).
model DocumentCheck {
  id             String     @id @default(cuid())
  /// The private file name in the documents folder
  file           String     @unique
  /// RESIDENT_ID, LICENSE, OR_CR or PERMIT
  kind           String
  userId         String?
  verdict        DocVerdict
  /// What it looked like, e.g. "Driver's license"
  documentType   String?
  nameOnDocument String?
  birthDate      String?
  expiresOn      String?
  nameMatches    Boolean?
  /// Why it needs a look, in plain words
  reasons        String[]   @default([])
  numberHash     String?
  model          String?
  createdAt      DateTime   @default(now())

  @@index([numberHash])
  @@index([userId])
}

/// The kinds of shops a Pabili can be bought at
enum ShopCategory {
  GROCERY
  SARI_SARI
  MARKET
  RICE
  BAKERY
  PHARMACY
  HARDWARE
  SCHOOL_SUPPLIES
  WATER
  LPG
  AGRI_PET
  PERSONAL_CARE
  GADGETS
  FRUITS
  OTHER
}

/// What happens when a word is on a Pabili list
enum RestrictRule {
  /// Never sent
  BANNED
  /// Only from a botika, with a photo of the prescription
  PRESCRIPTION
  /// 18 and older with a verified ID; none during a liquor ban
  ALCOHOL
  /// 18 and older with a verified ID
  TOBACCO
  /// Sealed only; the rider is told
  CHEMICAL
  /// A cooking gas tank: only if the rider can carry it safely
  LPG
  /// May not fit on a motorcycle
  BULKY
}

enum SuggestionStatus {
  OPEN
  ADDED
  DISMISSED
}

/// A shop in Naval the admin lists for Pabili: no map, just its kind, barangay and landmark
model PabiliShop {
  id        String       @id @default(cuid())
  name      String
  category  ShopCategory
  barangay  String?
  landmark  String
  /// As people say it, e.g. "7 AM to 8 PM, closed Sundays"
  hours     String?
  /// The same shop on Feasto: residents are pointed to its menu
  vendorId  String?
  vendor    Vendor?      @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @default(now()) @updatedAt
  errands   Errand[]

  @@index([category, isActive])
}

/// A shop a resident used that isn't listed yet, for the admin to add
model PabiliShopSuggestion {
  id        String           @id @default(cuid())
  userId    String?
  user      User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  category  ShopCategory
  location  String
  status    SuggestionStatus @default(OPEN)
  createdAt DateTime         @default(now())

  @@index([status, createdAt])
}

/// A word on a Pabili list that's not allowed or needs something (Filipino and English)
model RestrictedTerm {
  id        String       @id @default(cuid())
  term      String       @unique
  rule      RestrictRule
  createdAt DateTime     @default(now())
}
