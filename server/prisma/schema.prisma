// Feasto database schema.
// After editing this file run `npm run db:migrate` to create a migration.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  RESIDENT
  RIDER
  VENDOR
  ADMIN
}

/// Review state of a vendor's store or a rider's account. Admins move it out of PENDING.
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

/// The kind of food business. Residents filter stores by it.
enum StoreType {
  RESTAURANT
  FAST_FOOD
  CARINDERIA
  CAFE
  BAKERY
  MILK_TEA_DRINKS
  SNACKS_STREET_FOOD
  DESSERTS
  HOME_KITCHEN
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum OrderStatus {
  AWAITING_PAYMENT // online payment not confirmed yet; vendors don't see it
  PLACED
  ACCEPTED
  PREPARING
  READY
  PICKED_UP // delivery: the rider collected it
  DELIVERED // delivery: handed to the resident
  COMPLETED // pickup: the resident collected it
  REJECTED
  CANCELLED
}

/// How far a delivery job has spread among riders. Each step is explained in lib/dispatch.ts.
enum JobDispatch {
  NEW
  STORE_RIDERS
  NEAREST
  WIDER
  EVERYONE
}

/// Where a store's or rider's replacement document is. DRAFT has the file but wasn't submitted yet.
enum RenewalStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

/// The filters on the admin's activity log.
enum ActivityCategory {
  APPROVALS
  DOCUMENTS
  ACCOUNTS
  ORDERS
  SETTINGS
}

enum Fulfillment {
  DELIVERY
  PICKUP
}

enum PaymentMethod {
  COD
  ONLINE
}

/// Which wallet or card an online payment uses. Payments are simulated; no money moves.
enum OnlinePayment {
  GCASH
  MAYA
  GRABPAY
  SHOPEEPAY
  COINS
  VISA
  MASTERCARD
  JCB
  AMEX
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String
  name              String
  phone             String?
  role              Role      @default(RESIDENT)
  /// Set by an admin to block the account; the user is logged out everywhere at once
  disabledAt        DateTime?
  /// Sessions signed before this moment stop working, so a new password logs out other devices
  passwordChangedAt DateTime?
  createdAt         DateTime  @default(now())

  vendor        Vendor? // set when role = VENDOR
  riderProfile  RiderProfile? // set when role = RIDER
  checkouts     Checkout[]
  deliveries    Order[]        @relation("RiderDeliveries")
  jobOffers     JobOffer[]
  bookings      Booking[]
  addresses     Address[]
  notifications Notification[]
  reviews       Review[]
  favorites     Favorite[]
}

/// A resident's saved delivery address.
model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  label     String // "Home", "Office"
  details   String // street, barangay, city
  landmark  String?
  /// Pin on the map, set by the resident (GPS or dragging the pin)
  latitude  Float?
  longitude Float?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Vendor {
  id                  String         @id @default(cuid())
  ownerId             String         @unique
  owner               User           @relation(fields: [ownerId], references: [id])
  name                String
  storeType           StoreType
  /// Only stores with this on appear under "Book a table"
  acceptsReservations Boolean        @default(false)
  description         String?
  address             String
  /// Pin on the map, set by the vendor in Store settings
  latitude            Float?
  longitude           Float?
  imageUrl            String?
  /// The registered business, which can differ from the name residents see
  businessName        String?
  businessPhone       String?
  permitNumber        String?
  permitExpiresAt     DateTime?      @db.Date
  /// File name of the business permit in the private documents folder, never a public URL
  permitFile          String?
  /// Riders enter this when they sign up to join this store
  riderCode           String         @unique
  status              ApprovalStatus @default(PENDING)
  reviewNote          String? // admin's reason when rejecting or suspending
  reviewedAt          DateTime?
  opensAt             String // "08:00"
  closesAt            String // "21:00"
  /// The vendor's manual "closed for now" switch, on top of the opening hours
  isTemporarilyClosed Boolean        @default(false)
  /// Ways to pay this store takes. A cart's choices are the ones every store in it takes.
  acceptsCash         Boolean        @default(true)
  onlinePayments      OnlinePayment[] @default([GCASH, MAYA, GRABPAY, SHOPEEPAY, COINS, VISA, MASTERCARD, JCB, AMEX])
  /// Running totals of all ratings, updated in the same transaction as each new review,
  /// so store lists can show the average without adding up every review
  ratingSum           Int            @default(0)
  ratingCount         Int            @default(0)
  createdAt           DateTime       @default(now())

  menuItems MenuItem[]
  orders    Order[]
  tables    DiningTable[]
  reviews   Review[]
  favoredBy Favorite[]
  riders    RiderProfile[]
  renewals  DocumentRenewal[]
}

/// A motorcycle rider's details. Riders can't go online or take jobs until they're approved:
/// by their store if they joined one with its code, otherwise by the admin.
model RiderProfile {
  id               String         @id @default(cuid())
  userId           String         @unique
  user             User           @relation(fields: [userId], references: [id])
  /// The store this rider works for; null for a free rider
  vendorId         String?
  vendor           Vendor?        @relation(fields: [vendorId], references: [id])
  /// Motorcycle make and model, e.g. Honda Click 125
  vehicleModel     String?
  plateNumber      String?
  licenseNumber    String?        @unique
  licenseExpiresAt DateTime?      @db.Date
  /// File name of the license photo in the private documents folder, never a public URL
  licenseFile      String?
  birthDate        DateTime?      @db.Date
  address          String?
  emergencyName    String?
  emergencyPhone   String?
  status           ApprovalStatus @default(PENDING)
  reviewNote       String?
  reviewedAt       DateTime?
  /// Only the admin can lift a suspension the admin made, not the rider's store
  suspendedByAdmin Boolean        @default(false)
  isOnline         Boolean        @default(false)
  createdAt        DateTime       @default(now())

  renewals DocumentRenewal[]

  @@index([vendorId, status])
}

/// A replacement for an approved store's permit or rider's license. It stays separate until the
/// reviewer approves it, so the document on file is always one that somebody checked.
/// The migration adds partial unique indexes: at most one DRAFT or PENDING per store or rider.
model DocumentRenewal {
  id          String        @id @default(cuid())
  vendorId    String?
  vendor      Vendor?       @relation(fields: [vendorId], references: [id])
  riderId     String?
  rider       RiderProfile? @relation(fields: [riderId], references: [id])
  number      String?
  expiresAt   DateTime?     @db.Date
  /// File name in the private documents folder, until it's approved or rejected
  file        String?
  status      RenewalStatus @default(DRAFT)
  note        String? // the reason when rejected
  submittedAt DateTime?
  reviewedAt  DateTime?
  createdAt   DateTime      @default(now())

  @@index([status, submittedAt])
  @@index([vendorId])
  @@index([riderId])
}

/// What was done on Feasto, by whom, and why. The API only ever adds lines.
/// Names are copied so an old line stays true after someone changes their name.
model ActivityLog {
  id        String           @id @default(cuid())
  /// Null when Feasto did it automatically
  actorId   String?
  actorName String
  category  ActivityCategory
  action    String
  target    String
  detail    String?
  createdAt DateTime         @default(now())

  @@index([createdAt])
  @@index([category, createdAt])
}

/// What the admin can change without a new release. There's only ever one row, with id 1.
model PlatformSettings {
  id                Int      @id @default(1)
  /// Per store in a checkout. Orders keep the fee they were placed with.
  deliveryFee       Decimal  @default(49) @db.Decimal(10, 2)
  /// How long a store's own riders have a job to themselves
  storeRiderSeconds Int      @default(60)
  /// The wait between waves of free riders
  riderWaveSeconds  Int      @default(30)
  /// How long an order waits for a store or rider before the admin is told
  stuckMinutes      Int      @default(15)
  updatedAt         DateTime @updatedAt
}

model MenuItem {
  id          String    @id @default(cuid())
  vendorId    String
  vendor      Vendor    @relation(fields: [vendorId], references: [id])
  name        String
  category    String    @default("Others") // the vendor's own menu section, e.g. "Rice Meals"
  description String?
  price       Decimal   @db.Decimal(10, 2)
  imageUrl    String?
  stock       Int? // null = unlimited
  isAvailable Boolean   @default(true)
  /// Deleted dishes are hidden but kept, because past orders point to them
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())

  orderItems OrderItem[]

  @@index([vendorId])
}

/// One payment for a cart that may contain items from several vendors.
/// It is split into one Order per vendor, and those orders are processed in parallel.
model Checkout {
  id              String        @id @default(cuid())
  residentId      String
  resident        User          @relation(fields: [residentId], references: [id])
  fulfillment     Fulfillment
  paymentMethod   PaymentMethod
  /// Set for online payments; empty for cash and for orders from before wallets were offered
  onlineMethod    OnlinePayment?
  total           Decimal       @db.Decimal(10, 2)
  paymentStatus   PaymentStatus @default(PENDING)
  /// Sent by the client; a retried or double-clicked checkout reuses the key and is not created twice.
  idempotencyKey  String        @unique
  deliveryAddress String? // empty for pickup
  /// The address pin, copied at order time like the address text
  deliveryLat     Float?
  deliveryLng     Float?
  notes           String?
  createdAt       DateTime      @default(now())

  orders Order[]
}

/// The part of a checkout that belongs to a single vendor.
model Order {
  id               String      @id @default(cuid())
  checkoutId       String
  checkout         Checkout    @relation(fields: [checkoutId], references: [id])
  vendorId         String
  vendor           Vendor      @relation(fields: [vendorId], references: [id])
  riderId          String?
  rider            User?       @relation("RiderDeliveries", fields: [riderId], references: [id])
  status           OrderStatus @default(PLACED)
  fulfillment      Fulfillment
  subtotal         Decimal     @db.Decimal(10, 2)
  deliveryFee      Decimal     @default(0) @db.Decimal(10, 2)
  rejectReason     String?
  /// Photo the rider took at the door, under /uploads/
  deliveryPhotoUrl String?
  dispatch         JobDispatch @default(NEW)
  /// When the job should reach more riders; null when there's nothing left to do
  nextDispatchAt   DateTime?
  acceptedAt       DateTime?
  readyAt          DateTime?
  pickedUpAt       DateTime?
  finishedAt       DateTime? // delivered, collected, rejected or cancelled
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  items  OrderItem[]
  review Review?
  offers JobOffer[]

  @@index([vendorId, status])
  @@index([riderId])
  @@index([checkoutId])
  @@index([nextDispatchAt])
}

/// A free rider this job has reached so far. Only they can see and accept it until it opens to everyone.
model JobOffer {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  riderId   String
  rider     User     @relation(fields: [riderId], references: [id])
  createdAt DateTime @default(now())

  @@unique([orderId, riderId])
  @@index([riderId])
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  name       String // copied at order time so later menu edits don't change past orders
  unitPrice  Decimal  @db.Decimal(10, 2)
  quantity   Int
}

model DiningTable {
  id       String  @id @default(cuid())
  vendorId String
  vendor   Vendor  @relation(fields: [vendorId], references: [id])
  label    String // "Table 4"
  seats    Int
  /// Removed tables are hidden but kept, because past bookings point to them
  isActive Boolean @default(true)

  bookings Booking[]

  @@index([vendorId])
}

/// Reservations use fixed one-hour slots, so two bookings conflict only when they share a start time.
model Booking {
  id            String        @id @default(cuid())
  tableId       String
  table         DiningTable   @relation(fields: [tableId], references: [id])
  residentId    String
  resident      User          @relation(fields: [residentId], references: [id])
  startsAt      DateTime
  partySize     Int
  notes         String?
  status        BookingStatus @default(CONFIRMED)
  /// "<tableId>|<startsAt ISO>" while the booking is active, null once cancelled.
  /// The unique index lets the database reject a double-booking even when
  /// hundreds of requests for the same slot arrive at the same moment.
  activeSlotKey String?       @unique
  createdAt     DateTime      @default(now())

  @@index([tableId, startsAt])
}

/// A resident's rating of a finished order. One per order.
model Review {
  id         String   @id @default(cuid())
  orderId    String   @unique
  order      Order    @relation(fields: [orderId], references: [id])
  vendorId   String
  vendor     Vendor   @relation(fields: [vendorId], references: [id])
  residentId String
  resident   User     @relation(fields: [residentId], references: [id])
  rating     Int // 1 to 5 stars
  comment    String?
  createdAt  DateTime @default(now())

  @@index([vendorId, createdAt])
}

/// A store a resident saved to find again quickly.
model Favorite {
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id])
  createdAt DateTime @default(now())

  @@id([userId, vendorId])
  @@index([vendorId])
}

/// In-app notification. New ones are also pushed live to the user's open pages.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

/// Transactional outbox: events are saved in the same database transaction as the
/// change they describe, then relayed to RabbitMQ. If RabbitMQ or an API copy is down
/// at that moment, the worker's relay publishes them later, so no event is lost.
model OutboxEvent {
  id          String    @id @default(cuid())
  topic       String
  payload     Json
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([publishedAt, createdAt])
}
