{
	servers {
		# cloudflared (npm run tunnel) connects from the laptop and says the visitor used https
		trusted_proxies static private_ranges
		# ...and passes each visitor's real address in this header (used for rate limits)
		client_ip_headers CF-Connecting-IP
	}
}

# Phones on the classroom WiFi
{$SITE_ADDRESS} {
	tls /certs/server.pem /certs/server.key
	import routes.caddy
}

# The same site for the Cloudflare tunnel (npm run tunnel), for people on other networks.
# Only the laptop itself can reach this port.
http://:8081 {
	import routes.caddy
}
